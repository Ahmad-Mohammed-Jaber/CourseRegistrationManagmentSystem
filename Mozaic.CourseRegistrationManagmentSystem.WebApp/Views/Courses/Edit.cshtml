@model Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.CourseFormViewModel
@{
    ViewData["Title"] = "Edit Course";
}

<!-- Page Header -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 font-bold mb-1">Edit Course</h1>
            <p class="text-muted">Update course @Model.CourseCode</p>
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-controller="Courses" asp-action="Index">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<div class="dashboard-row">
    <div class="dashboard-card">
        <div class="dashboard-card-header">
            <h5 class="dashboard-card-title mb-0">Course Details</h5>
        </div>
        <div class="dashboard-card-body">
            <form asp-controller="Courses" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="CourseCode" class="form-label"></label>
                    <input asp-for="CourseCode" class="form-control" />
                    <span asp-validation-for="CourseCode" class="text-danger d-block small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CourseName" class="form-label"></label>
                    <input asp-for="CourseName" class="form-control" />
                    <span asp-validation-for="CourseName" class="text-danger d-block small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CreditHours" class="form-label"></label>
                    <input asp-for="CreditHours" class="form-control" type="number" step="0.5" min="0" />
                    <span asp-validation-for="CreditHours" class="text-danger d-block small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger d-block small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>Save
                    </button>
                    <a class="btn btn-outline-secondary" asp-controller="Courses" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
