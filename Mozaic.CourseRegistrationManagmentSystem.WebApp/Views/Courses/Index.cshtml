@model Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.CourseListViewModel
@{
    ViewData["Title"] = "Courses";
}

<!-- Page Header -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 font-bold mb-1">Courses</h1>
            <p class="text-muted">Manage the course catalog</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-controller="Courses" asp-action="Create">
                <i class="bi bi-plus-circle me-2"></i>Add Course
            </a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<!-- Filters Row -->
<div class="dashboard-card mb-3">
    <form asp-controller="Courses" asp-action="Index" method="get" class="dashboard-card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label for="codeFilter" class="form-label small">Course Code</label>
                <input type="text" class="form-control" id="codeFilter" name="code" value="@Model.Code" placeholder="e.g. CS101" />
            </div>
            <div class="col-md-3">
                <label for="nameFilter" class="form-label small">Course Name</label>
                <input type="text" class="form-control" id="nameFilter" name="name" value="@Model.Name" placeholder="e.g. Data Structures" />
            </div>
            <div class="col-md-3">
                <label for="descriptionFilter" class="form-label small">Description</label>
                <input type="text" class="form-control" id="descriptionFilter" name="description" value="@Model.Description" placeholder="Text in the description" />
            </div>
            <div class="col-md-2">
                <label for="statusFilter" class="form-label small">Status</label>
                <select class="form-select" id="statusFilter" name="status">
                    <option value="All" selected="@(Model.Status == "All")">All</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Courses" asp-action="Index">Clear</a>
            </div>
        </div>
    </form>
</div>

<!-- Courses Table -->
<div class="dashboard-card">
    <div class="dashboard-card-header d-flex justify-content-between align-items-center">
        <h5 class="dashboard-card-title mb-0">All Courses</h5>
        <span class="badge bg-primary">@Model.TotalCount courses</span>
    </div>
    <div class="table-responsive">
        @if (Model.Courses.Count == 0)
        {
            <p class="text-muted px-3 py-3 mb-0">No courses found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(m => m.Courses[0].CourseCode)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Courses[0].CourseName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Courses[0].CreditHours)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Courses[0].IsActive)</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th scope="col">@Html.DisplayNameFor(m => m.Courses[0].CreatedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Courses[0].CreatedByName)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Courses[0].ModifiedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Courses[0].ModifiedByName)</th>
                        }
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Courses)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(_ => item.CourseCode)</td>
                            <td>@Html.DisplayFor(_ => item.CourseName)</td>
                            <td>@Html.DisplayFor(_ => item.CreditHours)</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td><small class="text-muted">@item.CreatedOn.ToString("g")</small></td>
                                <td><small>@item.CreatedByName</small></td>
                                <td><small class="text-muted">@item.ModifiedOn.ToString("g")</small></td>
                                <td><small>@item.ModifiedByName</small></td>
                            }
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Courses" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-controller="Courses" asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete course @item.CourseCode?');">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center px-3 py-3">
            <span class="text-muted">Page @(Model.Page) of @(Model.TotalPages) · @(Model.TotalCount) total</span>
            <nav aria-label="Courses pages">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
