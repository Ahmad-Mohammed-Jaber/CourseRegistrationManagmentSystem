@model List<Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.MyRegistrationViewModel>
@{
    ViewData["Title"] = "My Registrations";
}

<!-- Page Header -->
<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3 font-bold">My Registrations</h1>
        <p class="text-muted text-sm">Classes you are currently registered for.</p>
    </div>
    <a class="btn btn-outline-primary btn-sm" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

<partial name="_Alerts" />

<div class="dashboard-row">
    <div class="dashboard-card">
        <div class="dashboard-card-header d-flex justify-content-between align-items-center">
            <h5 class="dashboard-card-title mb-0">Enrolled Classes</h5>
            <span class="badge bg-primary">@Model.Count registered</span>
        </div>
        <div class="dashboard-card-body">
            @if (Model.Count == 0)
            {
                <p class="text-muted mb-0">You are not registered for any classes yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Html.DisplayNameFor(m => m[0].CourseName)</th>
                                <th>@Html.DisplayNameFor(m => m[0].ClassName)</th>
                                <th>@Html.DisplayNameFor(m => m[0].Instructor)</th>
                                <th>@Html.DisplayNameFor(m => m[0].Schedule)</th>
                                <th>@Html.DisplayNameFor(m => m[0].StartDate)</th>
                                <th>@Html.DisplayNameFor(m => m[0].EndDate)</th>
                                <th>@Html.DisplayNameFor(m => m[0].RegistrationDate)</th>
                                <th>@Html.DisplayNameFor(m => m[0].Status)</th>
                                <th aria-label="Actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(_ => item.CourseName)</td>
                                    <td>@Html.DisplayFor(_ => item.ClassName)</td>
                                    <td>@Html.DisplayFor(_ => item.Instructor)</td>
                                    <td>@Html.DisplayFor(_ => item.Schedule)</td>
                                    <td>@Html.DisplayFor(_ => item.StartDate)</td>
                                    <td>@Html.DisplayFor(_ => item.EndDate)</td>
                                    <td>@Html.DisplayFor(_ => item.RegistrationDate)</td>
                                    <td>@Html.DisplayFor(_ => item.Status)</td>
                                    <td class="text-end">
                                        <form asp-controller="Registrations" asp-action="Drop" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.RegistrationId" />
                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to drop this class?');">
                                                <i class="bi bi-x-circle me-1"></i>Drop
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
