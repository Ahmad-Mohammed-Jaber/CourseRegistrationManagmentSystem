@model Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.MyRegistrationsListViewModel
@{
    ViewData["Title"] = "My Registrations";
}

<!-- Page Header -->
<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3 font-bold">My Registrations</h1>
        <p class="text-muted text-sm">Classes you are currently registered for.</p>
    </div>
    <a class="btn btn-outline-primary btn-sm" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

<partial name="_Alerts" />

<!-- Filters Row -->
<div class="dashboard-card mb-3">
    <form asp-controller="Registrations" asp-action="Mine" method="get" class="dashboard-card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="courseFilter" class="form-label small">Course</label>
                <input type="text" class="form-control" id="courseFilter" name="course" value="@Model.Course" placeholder="Course code or name" />
            </div>
            <div class="col-md-3">
                <label for="classNameFilter" class="form-label small">Class</label>
                <input type="text" class="form-control" id="classNameFilter" name="className" value="@Model.ClassName" placeholder="Class name" />
            </div>
            <div class="col-md-2">
                <label for="statusFilter" class="form-label small">Status</label>
                <select class="form-select" id="statusFilter" name="status">
                    <option value="All" selected="@(Model.Status == "All")">All</option>
                    <option value="Registered" selected="@(Model.Status == "Registered")">Registered</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Dropped" selected="@(Model.Status == "Dropped")">Dropped</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Registrations" asp-action="Mine">Clear</a>
            </div>
        </div>
    </form>
</div>

<div class="dashboard-row">
    <div class="dashboard-card">
        <div class="dashboard-card-header d-flex justify-content-between align-items-center">
            <h5 class="dashboard-card-title mb-0">Enrolled Classes</h5>
            <span class="badge bg-primary">@Model.TotalCount registered</span>
        </div>
        <div class="dashboard-card-body">
            @if (Model.Registrations.Count == 0)
            {
                <p class="text-muted mb-0">No registrations match your search.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Html.DisplayNameFor(m => m.Registrations[0].CourseName)</th>
                                <th>@Html.DisplayNameFor(m => m.Registrations[0].ClassName)</th>
                                <th>@Html.DisplayNameFor(m => m.Registrations[0].Instructor)</th>
                                <th>@Html.DisplayNameFor(m => m.Registrations[0].Schedule)</th>
                                <th>@Html.DisplayNameFor(m => m.Registrations[0].StartDate)</th>
                                <th>@Html.DisplayNameFor(m => m.Registrations[0].EndDate)</th>
                                <th>@Html.DisplayNameFor(m => m.Registrations[0].RegistrationDate)</th>
                                <th>@Html.DisplayNameFor(m => m.Registrations[0].Status)</th>
                                <th aria-label="Actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Registrations)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(_ => item.CourseName)</td>
                                    <td>@Html.DisplayFor(_ => item.ClassName)</td>
                                    <td>@Html.DisplayFor(_ => item.Instructor)</td>
                                    <td>@Html.DisplayFor(_ => item.Schedule)</td>
                                    <td>@Html.DisplayFor(_ => item.StartDate)</td>
                                    <td>@Html.DisplayFor(_ => item.EndDate)</td>
                                    <td>@Html.DisplayFor(_ => item.RegistrationDate)</td>
                                    <td><span class="badge @Mozaic.CourseRegistrationManagementSystem.WebApp.StatusBadgeHelper.GetBadgeClass(item.Status)">@Html.DisplayFor(_ => item.Status)</span></td>
                                    <td class="text-end">
                                        <form asp-controller="Registrations" asp-action="Drop" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.RegistrationId" />
                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to drop this class?');">
                                                <i class="bi bi-x-circle me-1"></i>Drop
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center px-3 py-3">
                <span class="text-muted">Page @(Model.Page) of @(Model.TotalPages) · @(Model.TotalCount) total</span>
                <nav aria-label="My registrations pages">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link" asp-action="Mine" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page - 1)">Previous</a>
                        </li>
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link" asp-action="Mine" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
