@model Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.RegistrationListViewModel
@{
    ViewData["Title"] = "Registrations";
}

<!-- Page Header -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 font-bold mb-1">Registrations</h1>
            <p class="text-muted">Manage all registrations</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-controller="Registrations" asp-action="Create">
                <i class="bi bi-plus-circle me-2"></i>Add Registration
            </a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<!-- Filters Row -->
<div class="dashboard-card mb-3">
    <form asp-controller="Registrations" asp-action="Index" method="get" class="dashboard-card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="studentFilter" class="form-label small">Student</label>
                <input type="text" class="form-control" id="studentFilter" name="student" value="@Model.Student" placeholder="Number, name or email" />
            </div>
            <div class="col-md-3">
                <label for="courseFilter" class="form-label small">Course</label>
                <input type="text" class="form-control" id="courseFilter" name="course" value="@Model.Course" placeholder="Code or name" />
            </div>
            <div class="col-md-2">
                <label for="classNameFilter" class="form-label small">Class</label>
                <input type="text" class="form-control" id="classNameFilter" name="className" value="@Model.ClassName" placeholder="Class name" />
            </div>
            <div class="col-md-2">
                <label for="statusFilter" class="form-label small">Status</label>
                <select class="form-select" id="statusFilter" name="status">
                    <option value="All" selected="@(Model.Status == "All")">All</option>
                    <option value="Registered" selected="@(Model.Status == "Registered")">Registered</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Dropped" selected="@(Model.Status == "Dropped")">Dropped</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Registrations" asp-action="Index">Clear</a>
            </div>
        </div>
    </form>
</div>

<!-- Registrations Table -->
<div class="dashboard-card">
    <div class="dashboard-card-header d-flex justify-content-between align-items-center">
        <h5 class="dashboard-card-title mb-0">All Registrations</h5>
        <span class="badge bg-primary">@Model.TotalCount registrations</span>
    </div>
    <div class="table-responsive">
        @if (Model.Registrations.Count == 0)
        {
            <p class="text-muted px-3 py-3 mb-0">No registrations found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].StudentName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].CourseName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].ClassName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].RegistrationDate)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].Status)</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].CreatedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].CreatedByName)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].ModifiedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Registrations[0].ModifiedByName)</th>
                        }
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Registrations)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(_ => item.StudentName)</td>
                            <td>@Html.DisplayFor(_ => item.CourseName)</td>
                            <td>@Html.DisplayFor(_ => item.ClassName)</td>
                            <td>@Html.DisplayFor(_ => item.RegistrationDate)</td>
                            <td>
                                <span class="badge @Mozaic.CourseRegistrationManagementSystem.WebApp.StatusBadgeHelper.GetBadgeClass(item.Status)">@Html.DisplayFor(_ => item.Status)</span>
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td><small class="text-muted">@item.CreatedOn.ToString("g")</small></td>
                                <td><small>@item.CreatedByName</small></td>
                                <td><small class="text-muted">@item.ModifiedOn.ToString("g")</small></td>
                                <td><small>@item.ModifiedByName</small></td>
                            }
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Registrations" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-controller="Registrations" asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this registration?');">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center px-3 py-3">
            <span class="text-muted">Page @(Model.Page) of @(Model.TotalPages) · @(Model.TotalCount) total</span>
            <nav aria-label="Registrations pages">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
