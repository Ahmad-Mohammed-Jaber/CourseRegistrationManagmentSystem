@model List<Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.RegistrationListItemViewModel>
@{
    ViewData["Title"] = "Registrations";
}

<!-- Page Header -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 font-bold mb-1">Registrations</h1>
            <p class="text-muted">Manage all registrations</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-controller="Registrations" asp-action="Create">
                <i class="bi bi-plus-circle me-2"></i>Add Registration
            </a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<!-- Filters Row -->
<div class="dashboard-card mb-3">
    <form asp-controller="Registrations" asp-action="Index" method="get" class="dashboard-card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-10">
                <label for="searchFilter" class="form-label small">Search</label>
                <input type="text" class="form-control" id="searchFilter" name="q" value="@ViewData["Query"]" placeholder="Search by student, class, course..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Registrations" asp-action="Index">Clear</a>
            </div>
        </div>
    </form>
</div>

<!-- Registrations Table -->
<div class="dashboard-card">
    <div class="dashboard-card-header d-flex justify-content-between align-items-center">
        <h5 class="dashboard-card-title mb-0">All Registrations</h5>
        <span class="badge bg-primary">@Model.Count registrations</span>
    </div>
    <div class="table-responsive">
        @if (Model.Count == 0)
        {
            <p class="text-muted px-3 py-3 mb-0">No registrations found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].StudentName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].CourseName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].ClassName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].RegistrationDate)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].Status)</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(_ => item.StudentName)</td>
                            <td>@Html.DisplayFor(_ => item.CourseName)</td>
                            <td>@Html.DisplayFor(_ => item.ClassName)</td>
                            <td>@Html.DisplayFor(_ => item.RegistrationDate)</td>
                            <td>
                                <span class="badge bg-success">@Html.DisplayFor(_ => item.Status)</span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Registrations" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-controller="Registrations" asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this registration?');">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
