@model Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.ClassListViewModel
@{
    ViewData["Title"] = "Classes";
}

<!-- Page Header -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 font-bold mb-1">Classes</h1>
            <p class="text-muted">Manage class offerings</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-controller="Classes" asp-action="Create">
                <i class="bi bi-plus-circle me-2"></i>Add Class
            </a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<!-- Filters Row -->
<div class="dashboard-card mb-3">
    <form asp-controller="Classes" asp-action="Index" method="get" class="dashboard-card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="classNameFilter" class="form-label small">Class Name</label>
                <input type="text" class="form-control" id="classNameFilter" name="className" value="@Model.ClassName" placeholder="e.g. Section A" />
            </div>
            <div class="col-md-3">
                <label for="instructorFilter" class="form-label small">Instructor</label>
                <input type="text" class="form-control" id="instructorFilter" name="instructor" value="@Model.Instructor" placeholder="Instructor name" />
            </div>
            <div class="col-md-2">
                <label for="courseFilter" class="form-label small">Course</label>
                <input type="text" class="form-control" id="courseFilter" name="course" value="@Model.Course" placeholder="Code or name" />
            </div>
            <div class="col-md-2">
                <label for="statusFilter" class="form-label small">Status</label>
                <select class="form-select" id="statusFilter" name="status">
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                    <option value="All" selected="@(Model.Status == "All")">All</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Classes" asp-action="Index">Clear</a>
            </div>
        </div>
    </form>
</div>

<!-- Classes Table -->
<div class="dashboard-card">
    <div class="dashboard-card-header d-flex justify-content-between align-items-center">
        <h5 class="dashboard-card-title mb-0">All Classes</h5>
        <span class="badge bg-primary">@Model.TotalCount classes</span>
    </div>
    <div class="table-responsive">
        @if (Model.Classes.Count == 0)
        {
            <p class="text-muted px-3 py-3 mb-0">No classes found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].CourseName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].ClassName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].Instructor)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].Schedule)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].Seats)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].IsActive)</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].CreatedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].CreatedByName)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].ModifiedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Classes[0].ModifiedByName)</th>
                        }
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Classes)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(_ => item.CourseName)</td>
                            <td>
                                <div class="fw-semibold">@Html.DisplayFor(_ => item.ClassName)</div>
                                <small class="text-muted">@item.StartDate.ToString("d") – @item.EndDate.ToString("d")</small>
                            </td>
                            <td>@Html.DisplayFor(_ => item.Instructor)</td>
                            <td>@Html.DisplayFor(_ => item.Schedule)</td>
                            <td>@Html.DisplayFor(_ => item.Seats)</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td><small class="text-muted">@item.CreatedOn.ToString("g")</small></td>
                                <td><small>@item.CreatedByName</small></td>
                                <td><small class="text-muted">@item.ModifiedOn.ToString("g")</small></td>
                                <td><small>@item.ModifiedByName</small></td>
                            }
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Classes" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-controller="Classes" asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete class @item.ClassName?');">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center px-3 py-3">
            <span class="text-muted">Page @(Model.Page) of @(Model.TotalPages) · @(Model.TotalCount) total</span>
            <nav aria-label="Classes pages">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
