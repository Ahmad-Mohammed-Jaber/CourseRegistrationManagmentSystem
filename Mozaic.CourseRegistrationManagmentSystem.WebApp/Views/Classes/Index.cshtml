@model List<Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.ClassListItemViewModel>
@{
    ViewData["Title"] = "Classes";
}

<!-- Page Header -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 font-bold mb-1">Classes</h1>
            <p class="text-muted">Manage class offerings</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-controller="Classes" asp-action="Create">
                <i class="bi bi-plus-circle me-2"></i>Add Class
            </a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<!-- Filters Row -->
<div class="dashboard-card mb-3">
    <form asp-controller="Classes" asp-action="Index" method="get" class="dashboard-card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-10">
                <label for="searchFilter" class="form-label small">Search</label>
                <input type="text" class="form-control" id="searchFilter" name="q" value="@ViewData["Query"]" placeholder="Search by class, instructor, course..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Classes" asp-action="Index">Clear</a>
            </div>
        </div>
    </form>
</div>

<!-- Classes Table -->
<div class="dashboard-card">
    <div class="dashboard-card-header d-flex justify-content-between align-items-center">
        <h5 class="dashboard-card-title mb-0">All Classes</h5>
        <span class="badge bg-primary">@Model.Count classes</span>
    </div>
    <div class="table-responsive">
        @if (Model.Count == 0)
        {
            <p class="text-muted px-3 py-3 mb-0">No classes found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].CourseName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].ClassName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].Instructor)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].Schedule)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].Seats)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m[0].IsActive)</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th scope="col">@Html.DisplayNameFor(m => m[0].CreatedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m[0].CreatedByName)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m[0].ModifiedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m[0].ModifiedByName)</th>
                        }
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(_ => item.CourseName)</td>
                            <td>
                                <div class="fw-semibold">@Html.DisplayFor(_ => item.ClassName)</div>
                                <small class="text-muted">@item.StartDate.ToString("d") – @item.EndDate.ToString("d")</small>
                            </td>
                            <td>@Html.DisplayFor(_ => item.Instructor)</td>
                            <td>@Html.DisplayFor(_ => item.Schedule)</td>
                            <td>@Html.DisplayFor(_ => item.Seats)</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td><small class="text-muted">@item.CreatedOn.ToString("g")</small></td>
                                <td><small>@item.CreatedByName</small></td>
                                <td><small class="text-muted">@item.ModifiedOn.ToString("g")</small></td>
                                <td><small>@item.ModifiedByName</small></td>
                            }
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Classes" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-controller="Classes" asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete class @item.ClassName?');">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
