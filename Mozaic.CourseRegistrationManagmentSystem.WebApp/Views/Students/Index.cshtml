@model Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.StudentListViewModel
@{
    ViewData["Title"] = "Students";
}

<!-- Page Header -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 font-bold mb-1">Students</h1>
            <p class="text-muted">Manage student profiles</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-controller="Students" asp-action="Create">
                <i class="bi bi-plus-circle me-2"></i>Add Student
            </a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<!-- Filters Row -->
<div class="dashboard-card mb-3">
    <form asp-controller="Students" asp-action="Index" method="get" class="dashboard-card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label for="studentNumberFilter" class="form-label small">Student Number</label>
                <input type="text" class="form-control" id="studentNumberFilter" name="studentNumber" value="@Model.StudentNumber" placeholder="e.g. 2024001" />
            </div>
            <div class="col-md-2">
                <label for="fullNameFilter" class="form-label small">Full Name</label>
                <input type="text" class="form-control" id="fullNameFilter" name="fullName" value="@Model.FullName" placeholder="Student name" />
            </div>
            <div class="col-md-2">
                <label for="userNameFilter" class="form-label small">Username</label>
                <input type="text" class="form-control" id="userNameFilter" name="userName" value="@Model.UserName" placeholder="Login name" />
            </div>
            <div class="col-md-2">
                <label for="emailFilter" class="form-label small">Email</label>
                <input type="text" class="form-control" id="emailFilter" name="email" value="@Model.Email" placeholder="name@example.com" />
            </div>
            <div class="col-md-2">
                <label for="phoneFilter" class="form-label small">Phone</label>
                <input type="text" class="form-control" id="phoneFilter" name="phone" value="@Model.Phone" placeholder="Phone number" />
            </div>
            <div class="col-md-2">
                <label for="statusFilter" class="form-label small">Status</label>
                <select class="form-select" id="statusFilter" name="status">
                    <option value="All" selected="@(Model.Status == "All")">All</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Students" asp-action="Index">Clear</a>
            </div>
        </div>
    </form>
</div>

<!-- Students Table -->
<div class="dashboard-card">
    <div class="dashboard-card-header d-flex justify-content-between align-items-center">
        <h5 class="dashboard-card-title mb-0">All Students</h5>
        <span class="badge bg-primary">@Model.TotalCount students</span>
    </div>
    <div class="table-responsive">
        @if (Model.Students.Count == 0)
        {
            <p class="text-muted px-3 py-3 mb-0">No students found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(m => m.Students[0].StudentNumber)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Students[0].FullName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Students[0].UserName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Students[0].Email)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Students[0].Phone)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Students[0].IsActive)</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th scope="col">@Html.DisplayNameFor(m => m.Students[0].CreatedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Students[0].CreatedByName)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Students[0].ModifiedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Students[0].ModifiedByName)</th>
                        }
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Students)
                    {
                        <tr>
                            <td>@Html.DisplayFor(_ => item.StudentNumber)</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(item.FullName)&background=198754&color=fff"
                                         alt="@item.FullName"
                                         class="rounded-circle me-2"
                                         width="30"
                                         height="30"
                                         loading="lazy" />
                                    <span class="fw-semibold">@Html.DisplayFor(_ => item.FullName)</span>
                                </div>
                            </td>
                            <td>@Html.DisplayFor(_ => item.UserName)</td>
                            <td>@Html.DisplayFor(_ => item.Email)</td>
                            <td>@Html.DisplayFor(_ => item.Phone)</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td><small class="text-muted">@item.CreatedOn.ToString("g")</small></td>
                                <td><small>@item.CreatedByName</small></td>
                                <td><small class="text-muted">@item.ModifiedOn.ToString("g")</small></td>
                                <td><small>@item.ModifiedByName</small></td>
                            }
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Students" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-controller="Students" asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete student @item.UserName? This also removes their login account.');">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center px-3 py-3">
            <span class="text-muted">Page @(Model.Page) of @(Model.TotalPages) · @(Model.TotalCount) total</span>
            <nav aria-label="Students pages">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteValues" asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
