@model Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

@* Structure mirrors kiaalap/login.html 1:1; only the <form> posts to MVC and
   carries antiforgery + server-validation spans. Input ids match the template
   (username/password) so its script works verbatim. *@
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="brand-logo">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h1 class="h3 mb-2 fw-bold">Welcome Back!</h1>
            <p class="text-muted">Please login to your account</p>
        </div>

        <form asp-action="Login" method="post" id="loginForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            @* Model-level errors only (e.g. "Invalid username or password").
               Hidden by default; JS reveals it only when it has content. *@
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger auth-error-summary"
                 role="alert"
                 id="modelErrorSummary"></div>

            <div class="mb-3">
                <label class="form-label" for="username">Username</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <input type="text"
                           class="form-control"
                           id="username"
                           name="UserName"
                           value="@Model.UserName"
                           placeholder="Enter your username"
                           autocomplete="username"
                           required />
                </div>
                <span asp-validation-for="UserName" class="text-danger d-block small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock"></i>
                    </span>
                    <input type="password"
                           autocomplete="current-password"
                           class="form-control"
                           id="password"
                           name="Password"
                           placeholder="Enter your password"
                           required />
                    <button class="btn btn-outline-secondary"
                            type="button"
                            id="togglePassword"
                            aria-label="Toggle password visibility">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger d-block small"></span>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button class="btn btn-primary btn-lg" type="submit">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Sign In
                </button>
            </div>

            <hr class="my-4" />

            <div class="text-center">
                <p class="mb-0">
                    Don't have an account?
                    <a href="#" class="text-decoration-none fw-bold">
                        Sign up
                    </a>
                </p>
            </div>
        </form>
    </div>

    <div class="text-center mt-4">
        <p class="text-white-50 small">
            &copy; 2026 Mozaic. All rights reserved.
            <a href="#" class="text-white-50">Privacy</a> ·
            <a href="#" class="text-white-50">Terms</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle password visibility
        const togglePassword = document.getElementById('togglePassword');
        const password = document.getElementById('password');

        if (togglePassword) {
            togglePassword.addEventListener('click', function() {
                const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                password.setAttribute('type', type);
                this.querySelector('i').classList.toggle('bi-eye');
                this.querySelector('i').classList.toggle('bi-eye-slash');
            });
        }

        // Hide the model-level error summary when it has no content,
        // and reveal it cleanly when it does.
        const summary = document.getElementById('modelErrorSummary');
        if (summary) {
            const hasErrors = summary.querySelector('ul li, :scope > *:not(ul)') !== null
                              || summary.textContent.trim().length > 0;
            summary.style.display = hasErrors ? 'block' : 'none';
        }
    });
    </script>

    <style>
        /* Single alert block, only visible when it actually has errors. */
        .auth-error-summary {
            display: none;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            font-size: 0.9rem;
        }
        .auth-error-summary ul {
            margin: 0;
            padding-left: 1.25rem;
        }
        .auth-error-summary ul li {
            margin-bottom: 0.25rem;
        }
        .auth-error-summary ul li:last-child {
            margin-bottom: 0;
        }

        /* Per-field error spans: don't reserve space when empty. */
        span[asp-validation-for],
        .field-validation-error {
            margin-top: 0.25rem;
        }
        .field-validation-valid {
            display: none;
        }
    </style>
}