@{
    ViewData["Title"] = "Access Denied";
}

<div class="mb-3">
    <h1 class="h3 font-bold">Access Denied</h1>
    <p class="text-muted text-sm">You do not have permission to view this page.</p>
</div>

<div class="dashboard-row">
    <div class="dashboard-card">
        <div class="dashboard-card-body text-center">
            <i class="bi bi-shield-lock text-danger" style="font-size: 48px;"></i>
            <p class="text-muted mt-3">Contact an administrator if you believe this is a mistake.</p>
            <a asp-action="Login" asp-controller="Auth" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-2"></i>Back to Login
            </a>
        </div>
    </div>
</div>
