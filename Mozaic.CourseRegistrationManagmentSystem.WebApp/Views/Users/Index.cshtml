@model Mozaic.CourseRegistrationManagmentSystem.WebApp.Models.UserListViewModel
@{
    ViewData["Title"] = "Users";
}

@* Structure mirrors kiaalap/all-courses.html: page header with action button,
   filters card with search, then the table card (dashboard-card >
   table-responsive > table.table.table-hover.align-middle) with avatar cells,
   badge statuses and per-row actions. *@
<!-- Page Header -->
<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 font-bold mb-1">Users</h1>
            <p class="text-muted">Manage accounts and roles</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-controller="Users" asp-action="Create">
                <i class="bi bi-plus-circle me-2"></i>Add User
            </a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<!-- Filters Row -->
<div class="dashboard-card mb-3">
    <form asp-controller="Users" asp-action="Index" method="get" class="dashboard-card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-10">
                <label for="searchFilter" class="form-label small">Search</label>
                <input type="text" class="form-control" id="searchFilter" name="q" value="@Model.Query" placeholder="Search by username or full name..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a class="btn btn-outline-secondary" asp-controller="Users" asp-action="Index">Clear</a>
            </div>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="dashboard-card">
    <div class="dashboard-card-header d-flex justify-content-between align-items-center">
        <h5 class="dashboard-card-title mb-0">All Users</h5>
        <span class="badge bg-primary">@Model.TotalCount users</span>
    </div>
    <div class="table-responsive">
        @if (Model.Users.Count == 0)
        {
            <p class="text-muted px-3 py-3 mb-0">No users found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(m => m.Users[0].FullName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Users[0].UserName)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Users[0].Role)</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Users[0].IsActive)</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th scope="col">@Html.DisplayNameFor(m => m.Users[0].CreatedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Users[0].CreatedByName)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Users[0].ModifiedOn)</th>
                            <th scope="col">@Html.DisplayNameFor(m => m.Users[0].ModifiedByName)</th>
                        }
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(item.FullName)&background=6366f1&color=fff"
                                         alt="@item.FullName"
                                         class="rounded-circle me-2"
                                         width="30"
                                         height="30"
                                         loading="lazy" />
                                    <span class="fw-semibold">@Html.DisplayFor(_ => item.FullName)</span>
                                </div>
                            </td>
                            <td>@Html.DisplayFor(_ => item.UserName)</td>
                            <td>
                                @if (item.Role == "Admin")
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">Student</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td><small class="text-muted">@item.CreatedOn.ToString("g")</small></td>
                                <td><small>@item.CreatedByName</small></td>
                                <td><small class="text-muted">@item.ModifiedOn.ToString("g")</small></td>
                                <td><small>@item.ModifiedByName</small></td>
                            }
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Users" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-controller="Users" asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete user @item.UserName?');">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center px-3 py-3">
            <span class="text-muted">Page @(Model.Page) of @(Model.TotalPages) · @(Model.TotalCount) total</span>
            <nav aria-label="Users pages">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-q="@Model.Query">Previous</a>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-q="@Model.Query">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
