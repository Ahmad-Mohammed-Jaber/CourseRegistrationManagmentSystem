@using Mozaic.CourseRegistrationManagementSystem.WebApp
@using Mozaic.CourseRegistrationManagmentSystem.WebApp
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Page Header -->
<div class="mb-3">
    <h1 class="h3 font-bold">Admin Dashboard</h1>
    <p class="text-muted text-sm">Welcome back, @User.GetFullName()! Here's what's happening today.</p>
</div>

<div class="dashboard-row">
    <div class="dashboard-grid grid-cols-2">
        <div class="dashboard-card">
            <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                <h5 class="dashboard-card-title mb-0">Management</h5>
            </div>
            <div class="dashboard-card-body">
                <div class="list-group list-group-flush">
                    <a class="list-group-item d-flex align-items-center px-0 py-3 text-decoration-none" asp-controller="Users" asp-action="Index">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="bi bi-person-badge" style="color: #0d6efd;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">Users</h6>
                            <small class="text-muted">Manage accounts and roles</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a class="list-group-item d-flex align-items-center px-0 py-3 text-decoration-none" asp-controller="Students" asp-action="Index">
                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="bi bi-people" style="color: #198754;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">Students</h6>
                            <small class="text-muted">Manage student profiles</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a class="list-group-item d-flex align-items-center px-0 py-3 text-decoration-none" asp-controller="Courses" asp-action="Index">
                        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="bi bi-book" style="color: #0dcaf0;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">Courses</h6>
                            <small class="text-muted">Manage the course catalog</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a class="list-group-item d-flex align-items-center px-0 py-3 text-decoration-none" asp-controller="Classes" asp-action="Index">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="bi bi-easel" style="color: #ffc107;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">Classes</h6>
                            <small class="text-muted">Manage class offerings</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                    <a class="list-group-item d-flex align-items-center px-0 py-3 text-decoration-none" asp-controller="Registrations" asp-action="Index">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="bi bi-card-list" style="color: #0d6efd;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">Registrations</h6>
                            <small class="text-muted">Manage all registrations</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                <h5 class="dashboard-card-title mb-0">My Account</h5>
                <span class="badge bg-success">Active</span>
            </div>
            <div class="dashboard-card-body">
                <div class="d-flex align-items-center px-0 py-3">
                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(User.GetFullName())&background=6366f1&color=fff" alt="@User.GetFullName()" class="rounded-circle me-3" width="40" height="40" loading="lazy" />
                    <div class="flex-grow-1">
                        <h6 class="mb-1">@User.GetFullName()</h6>
                        <small class="text-muted">@User.Identity?.Name - Administrator</small>
                    </div>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
