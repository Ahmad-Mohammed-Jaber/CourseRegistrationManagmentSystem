@using Mozaic.CourseRegistrationManagmentSystem.WebApp
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="mb-3">
    <h1 class="h3 font-bold">Dashboard</h1>
    <p class="text-muted text-sm">Welcome back, @User.GetFullName()!</p>
</div>

<div class="dashboard-row">
    <div class="dashboard-grid grid-cols-2">
        <div class="stats-card">
            <div class="stats-card-label">Signed in as</div>
            <div class="stats-card-value">@User.Identity?.Name</div>
        </div>
        <div class="stats-card">
            <div class="stats-card-label">Full name</div>
            <div class="stats-card-value">@User.GetFullName()</div>
        </div>
    </div>
</div>
